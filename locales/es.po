#: core/link.py win_app/sender.py
msgid "The other machine"
msgstr "La otra máquina"

#: core/link.py
#, python-brace-format
msgid "Connection failed: {error}"
msgstr "La conexión falló: {error}"

#: core/link.py
#, python-brace-format
msgid "{name} closed the connection: it may have removed this machine, or be too busy to answer"
msgstr "{name} cerró la conexión: puede que haya eliminado esta máquina o que esté demasiado ocupada para responder"

#: core/link.py
msgid "This pairing was removed"
msgstr "Este emparejamiento se eliminó"

#: core/link.py
#, python-brace-format
msgid "{name} is unreachable from this machine. Check that both can communicate on the local network."
msgstr "{name} no es accesible desde esta máquina. Comprueba que ambas pueden comunicarse en la red local."

#: core/link.py
#, python-brace-format
msgid "{name} is reachable, but Beamer is not listening on this port."
msgstr "{name} es accesible, pero Beamer no está escuchando en este puerto."

#: core/link.py
#, python-brace-format
msgid "{name} did not answer before the connection timed out."
msgstr "{name} no respondió antes de que se agotara el tiempo de conexión."

#: core/link.py
#, python-brace-format
msgid "Connecting to {host}:{port}"
msgstr "Conectando a {host}:{port}"

#: core/link.py
msgid "This link was stopped"
msgstr "Este enlace se detuvo"

#: core/link.py
#, python-brace-format
msgid "Update Beamer on {name} to 1.5.0; if it is up to date, pair the two again"
msgstr "Actualiza Beamer en {name} a la 1.5.0; si ya está actualizado, vuelve a emparejar ambos"

#: core/link.py
#, python-brace-format
msgid "Connected to {name} via the secure macOS 27 fallback"
msgstr "Conectado a {name} mediante la alternativa segura de macOS 27"

#: core/link.py
#, python-brace-format
msgid "Connected to {name}"
msgstr "Conectado a {name}"

#: core/link.py
#, python-brace-format
msgid "{name} closed the connection"
msgstr "{name} cerró la conexión"

#: core/link.py
msgid "Sending to this machine was switched off"
msgstr "Se desactivó el envío a esta máquina"

#: core/link.py
#, python-brace-format
msgid "A different Beamer answered at {host}"
msgstr "Respondió otro Beamer en {host}"

#: core/link.py
#, python-brace-format
msgid "{name} stopped acknowledging input"
msgstr "{name} dejó de confirmar la entrada"

#: core/link.py
#, python-brace-format
msgid "{name} stopped accepting data"
msgstr "{name} dejó de aceptar datos"

#: core/link.py
#, python-brace-format
msgid "{name} did not answer as a Beamer: it is probably running one from before version 4"
msgstr "{name} no respondió como un Beamer: probablemente ejecuta uno anterior a la versión 4"

#: core/link.py
#, python-brace-format
msgid "{name} could not be authenticated: something on the path altered the link"
msgstr "No se pudo autenticar {name}: algo en el camino alteró el enlace"

#: core/link.py
#, python-brace-format
msgid "{name} did not answer like Beamer: {error}"
msgstr "{name} no respondió como Beamer: {error}"

#: core/link.py core/receiver.py
#, python-brace-format
msgid "{name} runs a newer Beamer: update Beamer on this machine"
msgstr "{name} ejecuta un Beamer más reciente: actualiza Beamer en esta máquina"

#: core/link.py
#, python-brace-format
msgid "{name} could not read what this machine sent first; Beamer on the two machines may differ"
msgstr "{name} no pudo leer lo que esta máquina envió primero; puede que Beamer difiera entre las dos máquinas"

#: core/link.py
#, python-brace-format
msgid "Could not save what {name} told this machine"
msgstr "No se pudo guardar lo que {name} indicó a esta máquina"

#: core/link.py
#, python-brace-format
msgid "The link to {name} failed: {error}"
msgstr "El enlace con {name} falló: {error}"

#: core/link.py
#, python-brace-format
msgid "{name} took too long to send one message"
msgstr "{name} tardó demasiado en enviar un mensaje"

#: core/link.py
msgid "The link failed"
msgstr "El enlace falló"

#: core/link.py
msgid "macOS 27 blocked direct LAN access. Open /Applications/Beamer Tunnel.command."
msgstr "macOS 27 bloqueó el acceso directo a la red local. Abre /Applications/Beamer Tunnel.command."

#: core/link.py
#, python-brace-format
msgid "{name} stopped responding"
msgstr "{name} dejó de responder"

#: core/link.py
#, python-brace-format
msgid "{name} did not answer as a Beamer"
msgstr "{name} no respondió como un Beamer"

#: core/link.py core/receiver.py
#, python-brace-format
msgid "Update Beamer on {name}: it is older than this one"
msgstr "Actualiza Beamer en {name}: es más antiguo que este"

#: core/link.py
#, python-brace-format
msgid "{name} has this pairing under another machine: use Re-pair on Overview."
msgstr "{name} tiene este emparejamiento con otra máquina: usa Volver a emparejar en Resumen."

#: core/link.py
#, python-brace-format
msgid "{name} no longer has this pairing: use Re-pair on Overview"
msgstr "{name} ya no tiene este emparejamiento: usa Volver a emparejar en Resumen"

#: core/peerlist.py
msgid "This pairing needs to be set up again."
msgstr "Hay que configurar este emparejamiento de nuevo."

#: core/peerlist.py
msgid "Pairing finished, but Beamer could not save it on this machine. Try again in a moment."
msgstr "El emparejamiento terminó, pero Beamer no pudo guardarlo en esta máquina. Inténtalo de nuevo en un momento."

#: core/peerlist.py
msgid "Another pairing is still finishing. Try again in a moment."
msgstr "Otro emparejamiento todavía está terminando. Inténtalo de nuevo en un momento."

#: core/peerlist.py
msgid "A wrong code was tried, so this code was cancelled. Show a new one to try again."
msgstr "Se probó un código incorrecto, así que este código se canceló. Muestra uno nuevo para intentarlo otra vez."

#: core/peerlist.py
msgid "A machine on an older Beamer tried to pair. Update Beamer on it to 1.5.0, then show a new code."
msgstr "Una máquina con un Beamer antiguo intentó emparejarse. Actualiza Beamer en ella a la 1.5.0 y muestra un código nuevo."

#: core/peerlist.py
msgid "The code expired. Show a new one."
msgstr "El código caducó. Muestra uno nuevo."

#: core/peerlist.py
msgid "That machine may already be paired here, or the code was wrong. Show a new code to try again."
msgstr "Puede que esa máquina ya esté emparejada aquí o que el código fuera incorrecto. Muestra un código nuevo para intentarlo otra vez."

#: core/peerlist.py
msgid "Beamer could not save the pairing on this machine, so it did not complete. Show a new code to try again."
msgstr "Beamer no pudo guardar el emparejamiento en esta máquina, así que no se completó. Muestra un código nuevo para intentarlo otra vez."

#: core/peerlist.py
msgid "That is this machine, not another one."
msgstr "Esa es esta máquina, no otra."

#: core/peerlist.py
#, python-brace-format
msgid "Pairing failed: {reason}."
msgstr "El emparejamiento falló: {reason}."

#: core/peerlist.py
msgid "That machine gave this machine's own identity, so nothing was paired. Show a new code to try again."
msgstr "Esa máquina dio la identidad de esta misma máquina, así que no se emparejó nada. Muestra un código nuevo para intentarlo otra vez."

#: core/peerlist.py
msgid "The saved pairing now identifies a different machine."
msgstr "El emparejamiento guardado ahora identifica a otra máquina."

#: core/peerlist.py
msgid "The other machine no longer has this pairing."
msgstr "La otra máquina ya no tiene este emparejamiento."

#: core/peerlist.py
#, python-brace-format
msgid "{name} is already paired with this machine. Remove it from the list first to pair again."
msgstr "{name} ya está emparejada con esta máquina. Quítala primero de la lista para volver a emparejarla."

#: core/peerlist.py
#, python-brace-format
msgid "{name} is not showing a code. Show one in Beamer on it, then try again."
msgstr "{name} no está mostrando un código. Muestra uno en su Beamer y vuelve a intentarlo."

#: core/peerlist.py
#, python-brace-format
msgid "That code was not accepted, and {name} has cancelled it. Show a new one there to try again."
msgstr "Ese código no se aceptó y {name} lo ha cancelado. Muestra uno nuevo allí para intentarlo otra vez."

