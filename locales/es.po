msgstr "Desbloquear Beamer Portable"

#: win_app/kvm_bridge_win.py
msgid "Choose a passphrase of at least 12 characters. You need it each time Beamer starts. It protects pairing keys if this folder is lost. A forgotten passphrase cannot be recovered."
msgstr "Elige una frase de contraseña de al menos 12 caracteres. La necesitarás cada vez que se inicie Beamer. Protege las claves de emparejamiento si se pierde esta carpeta. Una frase de contraseña olvidada no se puede recuperar."

#: win_app/kvm_bridge_win.py
msgid "Enter the passphrase for this portable folder."
msgstr "Introduce la frase de contraseña de esta carpeta portable."

#: win_app/kvm_bridge_win.py
msgid "Beamer requests keyboard and pointer access when each Wayland session starts."
msgstr "Beamer solicita acceso al teclado y al puntero al iniciar cada sesión de Wayland."

#: win_app/kvm_bridge_win.py win_app/pages_win.py
msgid "Not requested"
msgstr "No solicitado"

#: win_app/kvm_bridge_win.py
msgid "Ask again"
msgstr "Volver a solicitar"

#: win_app/kvm_bridge_win.py
