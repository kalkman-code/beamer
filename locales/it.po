#: core/link.py win_app/sender.py
msgid "The other machine"
msgstr "L'altro computer"

#: core/link.py
#, python-brace-format
msgid "Connection failed: {error}"
msgstr "Connessione non riuscita: {error}"

#: core/link.py
#, python-brace-format
msgid "{name} closed the connection: it may have removed this machine, or be too busy to answer"
msgstr "{name} ha chiuso la connessione: potrebbe aver rimosso questo computer, o essere troppo occupato per rispondere"

#: core/link.py
msgid "This pairing was removed"
msgstr "Questo abbinamento è stato rimosso"

#: core/link.py
#, python-brace-format
msgid "{name} is unreachable from this machine. Check that both can communicate on the local network."
msgstr "{name} non è raggiungibile da questo computer. Controlla che entrambi possano comunicare sulla rete locale."

#: core/link.py
#, python-brace-format
msgid "{name} is reachable, but Beamer is not listening on this port."
msgstr "{name} è raggiungibile, ma Beamer non è in ascolto su questa porta."

#: core/link.py
#, python-brace-format
msgid "{name} did not answer before the connection timed out."
msgstr "{name} non ha risposto prima che la connessione scadesse."

#: core/link.py
#, python-brace-format
msgid "Connecting to {host}:{port}"
msgstr "Connessione a {host}:{port}"

#: core/link.py
msgid "This link was stopped"
msgstr "Questo collegamento è stato interrotto"

#: core/link.py
#, python-brace-format
msgid "Update Beamer on {name} to 1.5.0; if it is up to date, pair the two again"
msgstr "Aggiorna Beamer su {name} alla 1.5.0; se è già aggiornato, abbina di nuovo i due computer"

#: core/link.py
#, python-brace-format
msgid "Connected to {name} via the secure macOS 27 fallback"
msgstr "Connesso a {name} tramite la modalità alternativa sicura di macOS 27"

#: core/link.py
#, python-brace-format
msgid "Connected to {name}"
msgstr "Connesso a {name}"

#: core/link.py
#, python-brace-format
msgid "{name} closed the connection"
msgstr "{name} ha chiuso la connessione"

#: core/link.py
msgid "Sending to this machine was switched off"
msgstr "L'invio a questo computer è stato disattivato"

#: core/link.py
#, python-brace-format
msgid "A different Beamer answered at {host}"
msgstr "Un altro Beamer ha risposto a {host}"

#: core/link.py
#, python-brace-format
msgid "{name} stopped acknowledging input"
msgstr "{name} ha smesso di confermare l'input"

#: core/link.py
#, python-brace-format
msgid "{name} stopped accepting data"
msgstr "{name} ha smesso di accettare dati"

#: core/link.py
#, python-brace-format
msgid "{name} did not answer as a Beamer: it is probably running one from before version 4"
msgstr "{name} non ha risposto come Beamer: probabilmente usa una versione precedente alla 4"

#: core/link.py
#, python-brace-format
msgid "{name} could not be authenticated: something on the path altered the link"
msgstr "Impossibile autenticare {name}: qualcosa lungo il percorso ha alterato il collegamento"

#: core/link.py
#, python-brace-format
msgid "{name} did not answer like Beamer: {error}"
msgstr "{name} non ha risposto come Beamer: {error}"

#: core/link.py core/receiver.py
#, python-brace-format
msgid "{name} runs a newer Beamer: update Beamer on this machine"
msgstr "{name} usa un Beamer più recente: aggiorna Beamer su questo computer"

#: core/link.py
#, python-brace-format
msgid "{name} could not read what this machine sent first; Beamer on the two machines may differ"
msgstr "{name} non è riuscito a leggere il primo messaggio di questo computer; le versioni di Beamer sui due computer potrebbero essere diverse"

#: core/link.py
#, python-brace-format
msgid "Could not save what {name} told this machine"
msgstr "Impossibile salvare ciò che {name} ha comunicato a questo computer"

#: core/link.py
#, python-brace-format
msgid "The link to {name} failed: {error}"
msgstr "Il collegamento con {name} non è riuscito: {error}"

#: core/link.py
#, python-brace-format
msgid "{name} took too long to send one message"
msgstr "{name} ha impiegato troppo tempo a inviare un messaggio"

#: core/link.py
msgid "The link failed"
msgstr "Il collegamento non è riuscito"

#: core/link.py
msgid "macOS 27 blocked direct LAN access. Open /Applications/Beamer Tunnel.command."
msgstr "macOS 27 ha bloccato l'accesso diretto alla rete locale. Apri /Applications/Beamer Tunnel.command."

#: core/link.py
#, python-brace-format
msgid "{name} stopped responding"
msgstr "{name} ha smesso di rispondere"

#: core/link.py
#, python-brace-format
msgid "{name} did not answer as a Beamer"
msgstr "{name} non ha risposto come Beamer"

#: core/link.py core/receiver.py
#, python-brace-format
msgid "Update Beamer on {name}: it is older than this one"
msgstr "Aggiorna Beamer su {name}: è più vecchio di questo"

#: core/link.py
#, python-brace-format
msgid "{name} has this pairing under another machine: use Re-pair on Overview."
msgstr "{name} ha questo abbinamento sotto un altro computer: usa Riabbina in Panoramica."

#: core/link.py
#, python-brace-format
msgid "{name} no longer has this pairing: use Re-pair on Overview"
msgstr "{name} non ha più questo abbinamento: usa Riabbina in Panoramica"

#: core/peerlist.py
msgid "This pairing needs to be set up again."
msgstr "Questo abbinamento va configurato di nuovo."

#: core/peerlist.py
msgid "Pairing finished, but Beamer could not save it on this machine. Try again in a moment."
msgstr "Abbinamento completato, ma Beamer non è riuscito a salvarlo su questo computer. Riprova tra un momento."

#: core/peerlist.py
msgid "Another pairing is still finishing. Try again in a moment."
msgstr "Un altro abbinamento è ancora in corso. Riprova tra un momento."

#: core/peerlist.py
msgid "A wrong code was tried, so this code was cancelled. Show a new one to try again."
msgstr "È stato provato un codice errato, quindi questo codice è stato annullato. Mostrane uno nuovo per riprovare."

#: core/peerlist.py
msgid "A machine on an older Beamer tried to pair. Update Beamer on it to 1.5.0, then show a new code."
msgstr "Un computer con una versione precedente di Beamer ha provato ad abbinarsi. Aggiorna Beamer su quel computer alla 1.5.0, poi mostra un nuovo codice."

#: core/peerlist.py
msgid "The code expired. Show a new one."
msgstr "Il codice è scaduto. Mostrane uno nuovo."

#: core/peerlist.py
msgid "That machine may already be paired here, or the code was wrong. Show a new code to try again."
msgstr "Quel computer potrebbe essere già abbinato qui, oppure il codice era errato. Mostra un nuovo codice per riprovare."

#: core/peerlist.py
msgid "Beamer could not save the pairing on this machine, so it did not complete. Show a new code to try again."
msgstr "Beamer non è riuscito a salvare l'abbinamento su questo computer, quindi non è stato completato. Mostra un nuovo codice per riprovare."

#: core/peerlist.py
msgid "That is this machine, not another one."
msgstr "Quello è questo stesso computer, non un altro."

#: core/peerlist.py
#, python-brace-format
msgid "Pairing failed: {reason}."
msgstr "Abbinamento non riuscito: {reason}."

#: core/peerlist.py
msgid "That machine gave this machine's own identity, so nothing was paired. Show a new code to try again."
msgstr "Quel computer ha fornito l'identità di questo computer, quindi non è stato abbinato nulla. Mostra un nuovo codice per riprovare."

#: core/peerlist.py
msgid "The saved pairing now identifies a different machine."
msgstr "L'abbinamento salvato ora identifica un altro computer."

#: core/peerlist.py
msgid "The other machine no longer has this pairing."
msgstr "L'altro computer non ha più questo abbinamento."

#: core/peerlist.py
#, python-brace-format
msgid "{name} is already paired with this machine. Remove it from the list first to pair again."
msgstr "{name} è già abbinato a questo computer. Rimuovilo prima dall'elenco per abbinarlo di nuovo."

#: core/peerlist.py
#, python-brace-format
msgid "{name} is not showing a code. Show one in Beamer on it, then try again."
msgstr "{name} non sta mostrando un codice. Mostrane uno in Beamer su quel computer, poi riprova."

#: core/peerlist.py
